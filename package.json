{
  "name": "canonical-feature-authority",
  "version": "0.1.0",
  "private": true,
  "description": "Reference file-system spine for the Canonical Feature Authority course — a worked example of intent-driven, deterministic projection from human need to generated code.",
  "type": "module",
  "scripts": {
    "init:projection": "npm --prefix ../declarative-typescript-body-projector run init-signing-key -- --private-key ../declarative-typescript-body-projector/.projector-keys/classroom-ed25519-private.pem --trust-file ../canonical-feature-authority/projection-authority/trusted-projector-keys.json --authority-root ../canonical-feature-authority --projector-id declarative-typescript-body-projector",
    "project:bodies": "npm --prefix ../declarative-typescript-body-projector run project-authority-tree -- --authority-root ../canonical-feature-authority --output-root ../canonical-feature-authority --signing-key ../declarative-typescript-body-projector/.projector-keys/classroom-ed25519-private.pem --trusted-keys ../canonical-feature-authority/projection-authority/trusted-projector-keys.json",
    "check:bodies": "npm --prefix ../declarative-typescript-body-projector run project-authority-tree -- --authority-root ../canonical-feature-authority --output-root ../canonical-feature-authority --trusted-keys ../canonical-feature-authority/projection-authority/trusted-projector-keys.json --check",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prove:projection": "npm run check:bodies && npm run build",
    "prove:lifecycle": "npm run check:bodies && npm run build && node dist/conformance/proves-projected-body-lifecycle.js"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
