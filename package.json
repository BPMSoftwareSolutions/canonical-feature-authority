{
  "name": "canonical-feature-authority",
  "version": "0.1.0",
  "private": true,
  "description": "Reference file-system spine for the Canonical Feature Authority course — a worked example of intent-driven, deterministic projection from human need to generated code.",
  "type": "module",
  "scripts": {
    "init:projection": "npm --prefix ../declarative-typescript-body-projector run init-signing-key -- --private-key ../declarative-typescript-body-projector/.projector-keys/classroom-ed25519-private.pem --trust-file ../canonical-feature-authority/projection-authority/trusted-projector-keys.json --authority-root ../canonical-feature-authority --projector-id declarative-typescript-body-projector",
    "project:bodies": "npm --prefix ../declarative-typescript-body-projector run project-authority-tree -- --authority-root ../canonical-feature-authority --output-root ../canonical-feature-authority --signing-key ../declarative-typescript-body-projector/.projector-keys/classroom-ed25519-private.pem --trusted-keys ../canonical-feature-authority/projection-authority/trusted-projector-keys.json",
    "check:bodies": "npm --prefix ../declarative-typescript-body-projector run project-authority-tree -- --authority-root ../canonical-feature-authority --output-root ../canonical-feature-authority --trusted-keys ../canonical-feature-authority/projection-authority/trusted-projector-keys.json --check",
    "materialize:provenance-contract": "node tools/materializes-bounded-model-submission-provenance-contract.mjs",
    "verify:provenance-contract": "node tools/verifies-bounded-model-submission-provenance-contract.mjs",
    "regenerate:provenance-contract": "node tools/regenerates-bounded-model-submission-provenance-contract.mjs",
    "inspect:provenance-contract": "node tools/inspects-provenance-contract-path.mjs",
    "adopt:governed-document": "node tools/adopts-governed-inspection-document.mjs",
    "project:governed-document": "node tools/projects-governed-inspection-document.mjs --write",
    "check:governed-document": "node tools/projects-governed-inspection-document.mjs --check",
    "hash:governed-document": "node tools/projects-governed-inspection-document.mjs --hash",
    "verify:governed-document": "node tools/verifies-governed-inspection-document.mjs",
    "prove:governed-document": "npm run check:governed-document && npm run verify:governed-document",
    "check:end-to-end-feature-contract": "node tools/projects-governed-inspection-document.mjs --authority architecture/inspects-end-to-end-feature-conveyor.authority.json --check",
    "verify:end-to-end-feature-contract": "node tools/verifies-governed-inspection-document.mjs --authority architecture/inspects-end-to-end-feature-conveyor.authority.json",
    "prove:end-to-end-feature-contract": "npm run check:end-to-end-feature-contract && npm run verify:end-to-end-feature-contract",
    "prove:governed-documents": "npm run prove:governed-document && npm run prove:end-to-end-feature-contract",
    "verify:canonical-feature-conveyor-contract": "node capabilities/end-to-end-canonical-feature-conveyor-fractal/projection/verifies-canonical-feature-conveyor-contract.mjs",
    "validate:canonical-feature-conveyor-implementation": "node capabilities/end-to-end-canonical-feature-conveyor-fractal/projection/projects-canonical-feature-conveyor-implementation.mjs --validate",
    "project:canonical-feature-conveyor-implementation": "node capabilities/end-to-end-canonical-feature-conveyor-fractal/projection/projects-canonical-feature-conveyor-implementation.mjs --write --root .",
    "check:canonical-feature-conveyor-implementation": "node capabilities/end-to-end-canonical-feature-conveyor-fractal/projection/projects-canonical-feature-conveyor-implementation.mjs --check --root .",
    "compare:canonical-feature-conveyor-implementation": "node capabilities/end-to-end-canonical-feature-conveyor-fractal/projection/projects-canonical-feature-conveyor-implementation.mjs --compare --root .",
    "project:canonical-feature-conveyor-derived-bodies": "node capabilities/end-to-end-canonical-feature-conveyor-fractal/projection/projects-canonical-feature-conveyor-derived-bodies.mjs --write",
    "check:canonical-feature-conveyor-derived-bodies": "node capabilities/end-to-end-canonical-feature-conveyor-fractal/projection/projects-canonical-feature-conveyor-derived-bodies.mjs --check",
    "project:canonical-feature-conveyor-contract": "npm run project:canonical-feature-conveyor-derived-bodies && node capabilities/end-to-end-canonical-feature-conveyor-fractal/projection/projects-canonical-feature-conveyor-contract.mjs --write",
    "check:canonical-feature-conveyor-contract": "npm run check:canonical-feature-conveyor-derived-bodies && node capabilities/end-to-end-canonical-feature-conveyor-fractal/projection/projects-canonical-feature-conveyor-contract.mjs --check",
    "prove:canonical-feature-conveyor-contract": "npm run check:canonical-feature-conveyor-contract && npm run check:canonical-feature-conveyor-implementation && npm run verify:canonical-feature-conveyor-contract",
    "project:deterministic-svg-presentation-contract": "node tools/projects-reviewed-capability-contract-markdown.mjs --contract architecture/projects-deterministic-svg-from-presentation-authority.contract.json --output architecture/projects-deterministic-svg-from-presentation-authority.md --write",
    "check:deterministic-svg-presentation-contract": "node tools/projects-reviewed-capability-contract-markdown.mjs --contract architecture/projects-deterministic-svg-from-presentation-authority.contract.json --output architecture/projects-deterministic-svg-from-presentation-authority.md --check",
    "hash:deterministic-svg-presentation-contract": "node tools/projects-reviewed-capability-contract-markdown.mjs --contract architecture/projects-deterministic-svg-from-presentation-authority.contract.json --output architecture/projects-deterministic-svg-from-presentation-authority.md --hash",
    "project:canonical-capability": "node tools/projects-canonical-capability-contract.mjs",
    "verify:canonical-capability-projector": "node tools/verifies-canonical-capability-projector.mjs",
    "project:deterministic-svg-capability": "node tools/projects-canonical-capability-contract.mjs --contract architecture/projects-deterministic-svg-from-presentation-authority.contract.json --root . --write",
    "check:deterministic-svg-capability": "node tools/projects-canonical-capability-contract.mjs --contract architecture/projects-deterministic-svg-from-presentation-authority.contract.json --root . --check",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prove:projection": "npm run prove:governed-documents && npm run check:bodies && npm run build",
    "prove:lifecycle": "npm run check:bodies && npm run build && node dist/conformance/proves-projected-body-lifecycle.js"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
