{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonical-feature-authority/schemas/governed-inspection-document-authority.schema.json",
  "title": "Governed inspection document authority",
  "description": "Canonical authority for deterministic projection of the ecosystem's constrained inspection-contract Markdown format.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorityType",
    "documentProfile",
    "documentId",
    "title",
    "projection",
    "blocks"
  ],
  "properties": {
    "authorityType": {
      "const": "governed-inspection-document-authority.v1"
    },
    "documentProfile": {
      "enum": [
        "canonical-markdown.v1",
        "authority-projection-implementation-contract.v1"
      ]
    },
    "documentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "title": {
      "$ref": "#/$defs/nonEmptyTrimmedLine"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "projection": {
      "$ref": "#/$defs/projection"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/block"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "documentProfile": {
            "const": "authority-projection-implementation-contract.v1"
          }
        }
      },
      "then": {
        "required": [
          "subject"
        ],
        "properties": {
          "subject": {
            "$ref": "#/$defs/subject"
          },
          "blocks": {
            "type": "array",
            "minItems": 14,
            "allOf": [
              {
                "$ref": "#/$defs/containsStatusHeading"
              },
              {
                "$ref": "#/$defs/containsUserStoryHeading"
              },
              {
                "$ref": "#/$defs/containsAcceptanceGherkinHeading"
              },
              {
                "$ref": "#/$defs/containsPhysicalFeatureAuthorityHeading"
              },
              {
                "$ref": "#/$defs/containsRepositorySpineHeading"
              },
              {
                "$ref": "#/$defs/containsCompleteArtifactSetHeading"
              },
              {
                "$ref": "#/$defs/containsProjectionLedgerHeading"
              },
              {
                "$ref": "#/$defs/containsNormativeEvidenceSchemasHeading"
              },
              {
                "$ref": "#/$defs/containsCompleteSejHeading"
              },
              {
                "$ref": "#/$defs/containsProjectedBodiesHeading"
              },
              {
                "$ref": "#/$defs/containsAcceptanceAlgorithmHeading"
              },
              {
                "$ref": "#/$defs/containsRedDispositionsHeading"
              },
              {
                "$ref": "#/$defs/containsManualInspectionHeading"
              },
              {
                "$ref": "#/$defs/containsExitConditionHeading"
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "line": {
      "type": "string",
      "pattern": "^[^\\r\\n]*$"
    },
    "nonEmptyLine": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]+$"
    },
    "nonEmptyTrimmedLine": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectorId",
        "projectorVersion",
        "outputPath",
        "mediaType",
        "encoding",
        "lineEnding",
        "blockSeparator",
        "terminalNewline",
        "outputByteSha256"
      ],
      "properties": {
        "projectorId": {
          "const": "canonical-governed-markdown-projector"
        },
        "projectorVersion": {
          "const": "1.0.0"
        },
        "outputPath": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+\\.md$"
        },
        "mediaType": {
          "const": "text/markdown"
        },
        "encoding": {
          "const": "UTF-8"
        },
        "lineEnding": {
          "enum": [
            "LF",
            "CRLF"
          ]
        },
        "blockSeparator": {
          "const": "blank-line"
        },
        "terminalNewline": {
          "const": true
        },
        "outputByteSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "featureId",
        "title",
        "userStory",
        "governingObligation",
        "scenarioIds"
      ],
      "properties": {
        "featureId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyTrimmedLine"
        },
        "userStory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "asA",
            "iWant",
            "soThat"
          ],
          "properties": {
            "asA": {
              "$ref": "#/$defs/nonEmptyTrimmedLine"
            },
            "iWant": {
              "$ref": "#/$defs/nonEmptyTrimmedLine"
            },
            "soThat": {
              "$ref": "#/$defs/nonEmptyTrimmedLine"
            }
          }
        },
        "governingObligation": {
          "$ref": "#/$defs/nonEmptyTrimmedLine"
        },
        "scenarioIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "containsStatusHeading": {
      "type": "array",
      "minContains": 1,
      "maxContains": 1,
      "contains": {
        "$ref": "#/$defs/statusHeading"
      }
    },
    "containsUserStoryHeading": {
      "type": "array",
      "minContains": 1,
      "maxContains": 1,
      "contains": {
        "$ref": "#/$defs/userStoryHeading"
      }
    },
    "containsAcceptanceGherkinHeading": {
      "type": "array",
      "minContains": 1,
      "maxContains": 1,
      "contains": {
        "$ref": "#/$defs/acceptanceGherkinHeading"
      }
    },
    "containsPhysicalFeatureAuthorityHeading": {
      "type": "array",
      "minContains": 1,
      "maxContains": 1,
      "contains": {
        "$ref": "#/$defs/physicalFeatureAuthorityHeading"
      }
    },
    "containsRepositorySpineHeading": {
      "type": "array",
      "minContains": 1,
      "maxContains": 1,
      "contains": {
        "$ref": "#/$defs/repositorySpineHeading"
      }
    },
    "containsCompleteArtifactSetHeading": {
      "type": "array",
      "minContains": 1,
      "maxContains": 1,
      "contains": {
        "$ref": "#/$defs/completeArtifactSetHeading"
      }
    },
    "containsProjectionLedgerHeading": {
      "type": "array",
      "minContains": 1,
      "maxContains": 1,
      "contains": {
        "$ref": "#/$defs/projectionLedgerHeading"
      }
    },
    "containsNormativeEvidenceSchemasHeading": {
      "type": "array",
      "minContains": 1,
      "maxContains": 1,
      "contains": {
        "$ref": "#/$defs/normativeEvidenceSchemasHeading"
      }
    },
    "containsCompleteSejHeading": {
      "type": "array",
      "minContains": 1,
      "maxContains": 1,
      "contains": {
        "$ref": "#/$defs/completeSejHeading"
      }
    },
    "containsProjectedBodiesHeading": {
      "type": "array",
      "minContains": 1,
      "maxContains": 1,
      "contains": {
        "$ref": "#/$defs/projectedBodiesHeading"
      }
    },
    "containsAcceptanceAlgorithmHeading": {
      "type": "array",
      "minContains": 1,
      "maxContains": 1,
      "contains": {
        "$ref": "#/$defs/acceptanceAlgorithmHeading"
      }
    },
    "containsRedDispositionsHeading": {
      "type": "array",
      "minContains": 1,
      "maxContains": 1,
      "contains": {
        "$ref": "#/$defs/redDispositionsHeading"
      }
    },
    "containsManualInspectionHeading": {
      "type": "array",
      "minContains": 1,
      "maxContains": 1,
      "contains": {
        "$ref": "#/$defs/manualInspectionHeading"
      }
    },
    "containsExitConditionHeading": {
      "type": "array",
      "minContains": 1,
      "maxContains": 1,
      "contains": {
        "$ref": "#/$defs/exitConditionHeading"
      }
    },
    "statusHeading": {
      "type": "object",
      "$ref": "#/$defs/exactLevelTwoHeading",
      "properties": {
        "text": {
          "const": "Status"
        }
      }
    },
    "userStoryHeading": {
      "type": "object",
      "$ref": "#/$defs/exactLevelTwoHeading",
      "properties": {
        "text": {
          "const": "User story"
        }
      }
    },
    "acceptanceGherkinHeading": {
      "type": "object",
      "$ref": "#/$defs/exactLevelTwoHeading",
      "properties": {
        "text": {
          "const": "Acceptance Gherkin"
        }
      }
    },
    "physicalFeatureAuthorityHeading": {
      "type": "object",
      "$ref": "#/$defs/exactLevelTwoHeading",
      "properties": {
        "text": {
          "const": "Physical canonical feature authority"
        }
      }
    },
    "repositorySpineHeading": {
      "type": "object",
      "$ref": "#/$defs/exactLevelTwoHeading",
      "properties": {
        "text": {
          "const": "Repository spine"
        }
      }
    },
    "completeArtifactSetHeading": {
      "type": "object",
      "$ref": "#/$defs/exactLevelTwoHeading",
      "properties": {
        "text": {
          "const": "Complete artifact set for the normative scenario"
        }
      }
    },
    "projectionLedgerHeading": {
      "type": "object",
      "$ref": "#/$defs/exactLevelTwoHeading",
      "properties": {
        "text": {
          "const": "Authority identity and projection ledger"
        }
      }
    },
    "normativeEvidenceSchemasHeading": {
      "type": "object",
      "$ref": "#/$defs/exactLevelTwoHeading",
      "properties": {
        "text": {
          "const": "Normative evidence schemas"
        }
      }
    },
    "completeSejHeading": {
      "type": "object",
      "$ref": "#/$defs/exactLevelTwoHeading",
      "properties": {
        "text": {
          "const": "Complete SEJ inputs"
        }
      }
    },
    "projectedBodiesHeading": {
      "type": "object",
      "$ref": "#/$defs/exactLevelTwoHeading",
      "properties": {
        "text": {
          "const": "Projected TypeScript bodies"
        }
      }
    },
    "acceptanceAlgorithmHeading": {
      "type": "object",
      "$ref": "#/$defs/exactLevelTwoHeading",
      "properties": {
        "text": {
          "const": "Ordered terminal acceptance algorithm"
        }
      }
    },
    "redDispositionsHeading": {
      "type": "object",
      "$ref": "#/$defs/exactLevelTwoHeading",
      "properties": {
        "text": {
          "const": "RED dispositions"
        }
      }
    },
    "manualInspectionHeading": {
      "type": "object",
      "$ref": "#/$defs/exactLevelTwoHeading",
      "properties": {
        "text": {
          "const": "Manual inspection sequence"
        }
      }
    },
    "exitConditionHeading": {
      "type": "object",
      "$ref": "#/$defs/exactLevelTwoHeading",
      "properties": {
        "text": {
          "const": "Implementation exit condition"
        }
      }
    },
    "exactLevelTwoHeading": {
      "type": "object",
      "required": [
        "blockType",
        "level",
        "text"
      ],
      "properties": {
        "blockType": {
          "const": "heading"
        },
        "level": {
          "const": 2
        },
        "text": {
          "$ref": "#/$defs/nonEmptyTrimmedLine"
        }
      }
    },
    "headingBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockType",
        "level",
        "text"
      ],
      "properties": {
        "blockType": {
          "const": "heading"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "text": {
          "$ref": "#/$defs/nonEmptyTrimmedLine"
        }
      }
    },
    "paragraphBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockType",
        "lines"
      ],
      "properties": {
        "blockType": {
          "const": "paragraph"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyLine"
          }
        }
      }
    },
    "fencedCodeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockType",
        "language",
        "lines"
      ],
      "properties": {
        "blockType": {
          "const": "fenced-code"
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_+.-]*$"
        },
        "lines": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/line"
              },
              {
                "not": {
                  "const": "```"
                }
              }
            ]
          }
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/headingBlock"
        },
        {
          "$ref": "#/$defs/paragraphBlock"
        },
        {
          "$ref": "#/$defs/fencedCodeBlock"
        }
      ]
    }
  }
}
