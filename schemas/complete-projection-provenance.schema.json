{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonical-feature-authority/schemas/complete-projection-provenance.schema.json",
  "title": "Complete non-circular provenance committed into a projected body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "canonicalizationAlgorithm",
    "provenancePath",
    "lineageRootSha256",
    "reviewedIntentAuthoritySha256",
    "gherkinSourceSha256",
    "gherkinSemanticSha256",
    "modelRequestAuthoritySha256",
    "providerAuthoritySha256",
    "providerRequestSha256",
    "providerResponseSha256",
    "semanticAuthoritySha256",
    "semanticExecutableSha256",
    "astAuthoritySha256",
    "runtimeCompositionAuthoritySha256",
    "expectationAuthoritySha256",
    "transformerDependencyGraphSha256",
    "executionPlanSha256",
    "terminalConformancePlanSha256",
    "finalLineagePlanSha256"
  ],
  "properties": {
    "schema": { "const": "complete-projection-provenance.v1" },
    "canonicalizationAlgorithm": { "const": "RFC8785-JCS" },
    "provenancePath": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "lineageRootSha256": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/sha256" },
    "reviewedIntentAuthoritySha256": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/sha256" },
    "gherkinSourceSha256": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/sha256" },
    "gherkinSemanticSha256": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/sha256" },
    "modelRequestAuthoritySha256": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/sha256" },
    "providerAuthoritySha256": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/sha256" },
    "providerRequestSha256": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/sha256" },
    "providerResponseSha256": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/sha256" },
    "semanticAuthoritySha256": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/sha256" },
    "semanticExecutableSha256": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/sha256" },
    "astAuthoritySha256": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/sha256" },
    "runtimeCompositionAuthoritySha256": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/sha256" },
    "expectationAuthoritySha256": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/sha256" },
    "transformerDependencyGraphSha256": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/sha256" },
    "executionPlanSha256": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/sha256" },
    "terminalConformancePlanSha256": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/sha256" },
    "finalLineagePlanSha256": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/sha256" }
  }
}
