        "outputPath": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+\\.md$"
        },
        "encoding": {
          "const": "UTF-8"
        },
        "lineEnding": {
          "enum": [
            "LF",
            "CRLF"
          ]
        },
        "outputByteSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
