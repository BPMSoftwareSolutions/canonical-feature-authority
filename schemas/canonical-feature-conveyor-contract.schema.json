        "member": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        }
      }
    },
    "stringLiteralExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
