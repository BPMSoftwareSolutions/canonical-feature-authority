        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "statements"
          ],
          "properties": {
            "kind": {
              "const": "Block"
            },
            "statements": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/returnStatement"
              }
            }
          }
        }
      }
