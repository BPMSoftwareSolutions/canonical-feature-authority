    "functionDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "modifiers",
        "parameters",
        "returnType",
        "body"
      ],
      "properties": {
        "kind": {
          "const": "FunctionDeclaration"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "modifiers": {
          "const": [
            "export",
            "async"
          ]
        },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "returnType": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "typeReference"
