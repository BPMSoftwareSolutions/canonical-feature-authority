          "properties": {
            "imports": {
              "type": "array",
              "maxItems": 0
            },
            "declarations": {
              "type": "array",
              "maxItems": 0
            },
            "ast": {
              "$ref": "#/$defs/sourceFileAst"
            }
          }
        }
      }
