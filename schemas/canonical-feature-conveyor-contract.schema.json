          "properties": {
            "language": {
              "const": "typescript"
            },
            "moduleProfile": {
              "const": "typescript-esm"
            },
            "languageProfileId": {
              "const": "typescript-collapsed-responsibility-body.v1"
            }
          }
        },
        "translation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceBodyId",
            "projectionId",
            "artifactPath"
