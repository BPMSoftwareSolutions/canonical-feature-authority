        },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/callArgument"
          }
        }
      }
    },
    "awaitExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
