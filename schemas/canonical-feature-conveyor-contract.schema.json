      ],
      "properties": {
        "executionSource": {
          "$ref": "#/$defs/jsonPointer"
        },
        "fixtureSource": {
          "$ref": "#/$defs/jsonPointer"
        },
        "expectedSignalSource": {
          "$ref": "#/$defs/jsonPointer"
        }
      }
    },
    "evaluationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticEvaluation",
        "projectedEvaluation",
        "translationEvaluation",
        "terminalDetermination"
      ],
      "properties": {
        "semanticEvaluation": {
          "$ref": "#/$defs/evaluationSource"
        },
        "projectedEvaluation": {
          "$ref": "#/$defs/evaluationSource"
        },
        "translationEvaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "compare",
            "requiredRelationship"
          ],
          "properties": {
            "compare": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/jsonPointer"
              }
            },
            "requiredRelationship": {
              "const": "canonical-equivalence"
            }
          }
        },
        "terminalDetermination": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semanticExecution",
            "projectedExecution",
            "translation",
            "disposition"
          ],
          "properties": {
            "semanticExecution": {
              "const": "CONFORMS"
            },
            "projectedExecution": {
              "const": "CONFORMS"
            },
            "translation": {
              "const": "EQUIVALENT"
            },
            "disposition": {
              "const": "PROJECTION_CONFORMS"
            }
          }
        }
      }
    },
    "tieOut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "ast",
        "code"
      ],
      "properties": {
        "authority": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "ast": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "code": {
          "$ref": "#/$defs/nonEmptyText"
        }
      }
    },
    "reviewAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questions",
        "translationTieOut",
        "admissionRule"
      ],
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyText"
          }
        },
        "translationTieOut": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tieOut"
          }
        },
