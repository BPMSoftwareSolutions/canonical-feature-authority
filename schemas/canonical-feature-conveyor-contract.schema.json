      "properties": {
        "kind": {
          "const": "AwaitExpression"
        },
        "expression": {
          "$ref": "#/$defs/callExpression"
        }
      }
    },
    "returnStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "expression"
      ],
      "properties": {
        "kind": {
          "const": "ReturnStatement"
        },
        "expression": {
          "$ref": "#/$defs/awaitExpression"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "typeReference",
        "immutable"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        "typeReference": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "immutable": {
          "const": true
        }
      }
