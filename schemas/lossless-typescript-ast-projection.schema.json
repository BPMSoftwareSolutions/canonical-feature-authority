{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.deterministic.solutions/projection/lossless-typescript-ast/1.0.0/schema.json",
  "title": "Lossless TypeScript AST projection authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "projectionId",
    "targetLanguage",
    "artifact",
    "lineage",
    "attestation",
    "sourceAst"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "schemaVersion", "schemaDigest"],
      "properties": {
        "schemaId": {
          "const": "https://schemas.deterministic.solutions/projection/lossless-typescript-ast/1.0.0/schema.json"
        },
        "schemaVersion": { "const": "1.0.0" },
        "schemaDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "projectionId": { "$ref": "#/$defs/id" },
    "targetLanguage": { "const": "typescript" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath"],
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.ts$"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "featureId",
        "scenarioId",
        "obligationId",
        "responsibilityId",
        "signalId"
      ],
      "properties": {
        "featureId": { "$ref": "#/$defs/id" },
        "scenarioId": { "$ref": "#/$defs/id" },
        "obligationId": { "$ref": "#/$defs/id" },
        "responsibilityId": { "$ref": "#/$defs/id" },
        "signalId": { "$ref": "#/$defs/id" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectorId", "keyId", "algorithm"],
      "properties": {
        "projectorId": { "$ref": "#/$defs/id" },
        "keyId": { "$ref": "#/$defs/sha256" },
        "algorithm": { "const": "ed25519" }
      }
    },
    "sourceAst": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "posture", "tokens", "topology"],
      "properties": {
        "profile": { "const": "lossless-typescript-ast.v1" },
        "posture": {
          "enum": [
            "executable",
            "type-contract",
            "test",
            "configuration",
            "negative-control"
          ]
        },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "text"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "topology": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "depth"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "depth": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
