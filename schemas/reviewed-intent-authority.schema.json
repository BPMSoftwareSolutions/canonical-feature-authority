{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonical-feature-authority/schemas/reviewed-intent-authority.schema.json",
  "title": "Reviewed intent authority with embedded provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["provenance", "payload"],
  "properties": {
    "provenance": {
      "allOf": [
        { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/provenance" },
        {
          "properties": {
            "artifactType": { "const": "reviewed-intent-authority" },
            "parent": { "type": "null" }
          }
        }
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentId",
        "featureId",
        "need",
        "promise",
        "scenarioIds",
        "allowedTransformers",
        "allowedProviderAuthorityIds",
        "admissionPolicyId"
      ],
      "properties": {
        "intentId": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/id" },
        "featureId": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/id" },
        "need": { "type": "string", "minLength": 1 },
        "promise": { "type": "string", "minLength": 1 },
        "scenarioIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/id" }
        },
        "allowedTransformers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/id" }
        },
        "allowedProviderAuthorityIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/id" }
        },
        "admissionPolicyId": {
          "$ref": "https://canonical-feature-authority/schemas/embedded-provenance.schema.json#/$defs/id"
        }
      }
    }
  }
}
